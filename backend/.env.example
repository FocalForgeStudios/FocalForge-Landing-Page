# Copy to .env for local development. Never commit real credentials.
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Exact public frontend origins, comma-separated. Include your custom domain when ready.
CORS_ORIGINS=https://focalforgestudios.github.io
# Optional shared secret header value for your automation/webhook receiver.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Set to 1 only if your platform requires TLS termination outside the app.
TRUST_PROXY=0
